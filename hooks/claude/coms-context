#!/usr/bin/env bash
# coms-kit hook: coms UserPromptSubmit hook for Claude Code.
#
# When a window's working directory is inside a coms-guarded repo, inject a short
# reminder (with a stable per-window holder id derived from the session) so any
# window coordinates shared-branch landings automatically, with no /coms and no
# paste. It is silent everywhere else: outside a guarded repo it prints nothing.
#
# Contract: on exit 0, stdout is added to the model's context for this turn.

umask 077
input=$(cat 2>/dev/null)
[ -z "$input" ] && exit 0

cwd=$(printf '%s' "$input" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("cwd",""))' 2>/dev/null)
sid=$(printf '%s' "$input" | python3 -c 'import sys,json;print(json.load(sys.stdin).get("session_id",""))' 2>/dev/null)
[ -z "$cwd" ] || [ -z "$sid" ] && exit 0
# Suggested invocations accept only the same bounded marker alphabet as the CLI.
case "$sid" in *[!A-Za-z0-9._:-]*) exit 0 ;; esac
[ "${#sid}" -le 256 ] || exit 0

# A guarded repo carries the coms-enabled mark in its shared .git (coms guard
# writes it). Repos guarded before the mark existed carry only the sentinel in
# their pre-commit hook.
marker_dir=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null) || exit 0
if [ ! -f "${marker_dir%/}/coms-enabled" ]; then
  hooks_dir=$(git -C "$cwd" rev-parse --path-format=absolute --git-path hooks 2>/dev/null) || exit 0
  grep -q "coms guard hook" "$hooks_dir/pre-commit" 2>/dev/null || exit 0
fi

# Canonical repo name via the common git dir, matching the CLI's _current_repo():
# every worktree of a repo shares one common dir, so the name is stable. The old
# --show-toplevel basename returned the WORKTREE name in linked worktrees, and the
# banner then recommended a worktree-keyed lease (worktree:main) that silently
# skipped the real queue on <repo>:main.
common=$(git -C "$cwd" rev-parse --path-format=absolute --git-common-dir 2>/dev/null)
repo=""
if [ -n "$common" ]; then
  common=${common%/}
  base=$(basename "$common")
  if [ "$base" = ".git" ]; then
    repo=$(basename "$(dirname "$common")")
  else
    repo=${base%.git}
  fi
fi
[ -z "$repo" ] && repo=$(basename "$(git -C "$cwd" rev-parse --show-toplevel 2>/dev/null)")
holder="claude-${sid:0:8}"
# Choose caller evidence, never copy a marker from an enrollment record.
# Automatic hooks route only the holder derived from the trusted harness payload.
session_var=COMS_SESSION_ID
marker="$sid"
if [ -n "${CLAUDE_CODE_SESSION_ID:-}" ]; then
  if [ "$CLAUDE_CODE_SESSION_ID" != "$sid" ]; then
    echo "[coms] This repo ($repo) is coordinated. Use your own marked holder for protected operations."
    echo "[coms] Native marker conflicts with this hook payload; mail injection refused. Resolve your own marker namespace before enrolling or reading."
    exit 0
  fi
  session_var=CLAUDE_CODE_SESSION_ID
fi
if [ "${COMS_HOLDER:-}" = "$holder" ] && [ -n "${COMS_SESSION_ID:-}" ]; then
  session_var=COMS_SESSION_ID
  marker="$COMS_SESSION_ID"
  case "$marker" in *[!A-Za-z0-9._:-]*) exit 0 ;; esac
  [ "${#marker}" -le 256 ] || exit 0
fi

cat <<EOF
[coms] This repo ($repo) is coordinated: other agents may be committing
here at the same time. Before any commit or merge to main/master, or a ship or
deploy, take your turn instead of running git directly:
  env -u COMS_SESSION_ID COMS_HOLDER=$holder $session_var=$marker coms do main -- <your git or merge command>
  env -u COMS_SESSION_ID COMS_HOLDER=$holder $session_var=$marker coms do ship -- <your ship or deploy command>
Bare "main"/"ship" auto-resolve to $repo:main / $repo:ship from any worktree; never
hand-build a worktree-named key, it takes a private lease and skips the queue.
A merge to a shared branch, a ship or a deploy needs the human's own yes first;
coms do only makes agents take turns, it never grants permission.
That waits your turn, runs it, releases, and returns the command's exit code. Use
the same COMS_HOLDER=$holder and $session_var=$marker for every coms command in this window. Room: coms status
EOF

# Reminder is available before enrollment; mail remains behind the identity gate.
env -u COMS_SESSION_ID COMS_HOLDER="$holder" "$session_var=$marker" coms identity-check >/dev/null 2>&1 || exit 0
env -u COMS_SESSION_ID COMS_HOLDER="$holder" "$session_var=$marker" coms hook-notifications context
exit 0
