#!/usr/bin/env python3
"""Send one alert per actionable state transition. Disabled until configured."""
import argparse
import fcntl
import hashlib
import http.client
import json
import os
import re
import subprocess
import sys
from pathlib import Path
from urllib.parse import urlencode, urlsplit


def post(host, target, body, content_type, telegram=False):
    connection = http.client.HTTPSConnection(host, timeout=10)
    try:
        connection.request("POST", target, body, {"Content-Type": content_type})
        response = connection.getresponse()
        if response.status // 100 != 2:
            raise ValueError("destination declined alert")
        if telegram and json.loads(response.read(4096)).get("ok") is not True:
            raise ValueError("destination declined alert")
    finally:
        connection.close()


def sender(backend, env):
    if backend == "command":
        executable = env.get("COMS_NOTIFY_COMMAND", "")
        if not os.path.isabs(executable) or not os.access(executable, os.X_OK):
            raise ValueError("set COMS_NOTIFY_COMMAND to an executable path")

        def run(message):
            subprocess.run([executable], input=message + "\n", text=True,
                           stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL,
                           env={k: env[k] for k in ("PATH", "HOME", "LANG") if k in env},
                           timeout=15, check=True)
        return run
    if backend == "ntfy":
        url = urlsplit(env.get("COMS_NTFY_URL", ""))
        if (url.scheme != "https" or not url.hostname or url.username is not None
                or url.path in ("", "/") or url.query or url.fragment):
            raise ValueError("set COMS_NTFY_URL to an HTTPS topic URL")
        return lambda message: post(url.netloc, url.path, message.encode(), "text/plain")
    if backend == "telegram":
        token = env.get("TELEGRAM_BOT_TOKEN", "")
        chat = env.get("TELEGRAM_CHAT_ID", "")
        if not re.fullmatch(r"[A-Za-z0-9:_-]+", token) or not chat:
            raise ValueError("set TELEGRAM_BOT_TOKEN and TELEGRAM_CHAT_ID")
        return lambda message: post("api.telegram.org", "/bot" + token + "/sendMessage",
                                    urlencode({"chat_id": chat, "text": message}),
                                    "application/x-www-form-urlencoded", telegram=True)
    raise ValueError("choose a supported notification backend")


def main(argv=None):
    parser = argparse.ArgumentParser(description=__doc__, epilog=(
        "Set COMS_NOTIFY_BACKEND to telegram, ntfy or command to opt in. "
        "Use the literal state ok for recovery. Message text goes to the selected destination."))
    parser.add_argument("--source", required=True, help="stable monitor name")
    parser.add_argument("--state", required=True, help="ok or a stable actionable state identifier")
    parser.add_argument("--message", required=True, help="short, shareable description")
    args = parser.parse_args(argv)
    backend = os.environ.get("COMS_NOTIFY_BACKEND")
    if not backend:
        return 0
    if not re.fullmatch(r"[A-Za-z0-9][A-Za-z0-9._-]{0,63}", args.source):
        parser.error("invalid source name")
    if not args.state.strip() or not 1 <= len(args.message.strip()) <= 3900:
        parser.error("supply a state and a message of at most 3900 characters")
    try:
        send = sender(backend, os.environ)
        root = Path(os.environ.get("COMS_NOTIFY_STATE_DIR", Path.home() / ".local/state/coms/notify"))
        root.mkdir(parents=True, mode=0o700, exist_ok=True)
        state_path = root / (args.source + ".state")
        digest = hashlib.sha256(args.state.encode()).hexdigest()
        with state_path.open("a+") as state:
            fcntl.flock(state, fcntl.LOCK_EX)
            state.seek(0)
            previous = state.read()
            if previous == "confirmed " + digest:
                return 0
            if previous in (digest, "attempted " + digest):
                print("notify: previous delivery unconfirmed; check the destination", file=sys.stderr)
                return 1

            def record(status):
                state.seek(0)
                state.truncate()
                state.write(status + " " + digest)
                state.flush()

            # A lost response can follow a real send. Do not resend implicitly.
            record("attempted")
            if args.state.casefold() not in {"ok", "success", "healthy", "clear", "recovered"}:
                send(args.message)
            record("confirmed")
    except (OSError, ValueError, subprocess.SubprocessError, http.client.HTTPException):
        print("notify: check configuration and destination before retrying", file=sys.stderr)
        return 1
    return 0


if __name__ == "__main__":
    sys.exit(main())
